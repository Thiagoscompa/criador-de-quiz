OPENAI_API_KEY=
# Opcional: modelos da OpenAI (padrão: gpt-5-mini para texto, gpt-5 para ler fotos)
OPENAI_MODEL=
OPENAI_MODEL_IMAGEM=
# Alternativa: use o Claude no lugar da OpenAI
ANTHROPIC_API_KEY=

# Limite de uso da IA por dia (padrão: 30 por visitante, 500 no total)
LIMITE_DIARIO_POR_VISITANTE=
LIMITE_DIARIO_TOTAL=
# Recomendado em produção para o limite valer em todas as instâncias (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: login, sincronização entre aparelhos e desafios com placar (Supabase).
# Copie de Supabase → Project Settings → API. São públicas; os dados ficam protegidos pelas regras de supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
